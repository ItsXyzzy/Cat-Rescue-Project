---
const { name, age, image, status, goodWithKids, description, id } = Astro.props;

const badgeClass = goodWithKids ? 'trait-green' : 'trait-amber';
const badgeText = goodWithKids ? 'Great with kids' : 'Quiet home';
---

<article class="cat-card">
  <div class="card-img">
    <img src={image} alt={name} loading="lazy" />
    <span class="age-pill">{age}</span>
  </div>
  <div class="card-body">
    <div class="card-top">
      <h3>{name}</h3>
      <span class={`trait-badge ${badgeClass}`}>{badgeText}</span>
    </div>
    {description && <p class="card-desc">{description}</p>}
    <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cats/${id}`} class="card-cta">Meet {name}</a>
  </div>
</article>

<style>
  .cat-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }
  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
  }

  .card-img {
    position: relative;
    height: 260px;
    overflow: hidden;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cat-card:hover .card-img img {
    transform: scale(1.04);
  }

  .age-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1C1C1C;
  }

  .card-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.8rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-top h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1C1C1C;
    margin: 0;
  }

  .trait-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .trait-green { background: #E6F4ED; color: #2D7D4F; }
  .trait-amber { background: #FEF3C7; color: #B45309; }

  .card-desc {
    font-size: 0.9rem;
    color: #5A5A5A;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    display: block;
    text-align: center;
    margin-top: auto;
    padding: 0.75rem;
    background: #F5EDE3;
    border-radius: 8px;
    color: #1C1C1C;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .card-cta:hover {
    background: #F26430;
    color: #fff;
  }
</style>
