---

---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="logo">Pawswick<span>Rescue</span></span>
      <p>A small rescue doing big things for cats in need.</p>
    </div>
    <div class="footer-links">
      <a href={`${import.meta.env.BASE_URL}cats`}>Cats for adoption</a>
      <a href={`${import.meta.env.BASE_URL}about`}>About us</a>
      <a href={`${import.meta.env.BASE_URL}volunteer`}>Volunteer</a>
      <a href={`${import.meta.env.BASE_URL}contact`}>Contact</a>
      <a href={`${import.meta.env.BASE_URL}donate`}>Donate</a>
    </div>
    <p class="footer-copy">&copy; {new Date().getFullYear()} Craig Dowdall. This is a template project to demonstrate a simple cat adoption website with CMS.</p>
  </div>
</footer>

<style>
  footer {
    background: #111;
    padding: 3.5rem 5%;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .logo span { color: #F26430; }

  .footer-brand p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 0.4rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: #fff; }

  .footer-copy {
    width: 100%;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.25);
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; text-align: center; }
    .footer-links { justify-content: center; }
  }
</style>
