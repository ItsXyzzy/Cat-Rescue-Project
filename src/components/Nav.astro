---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (path: string) => {
  return currentPath === path || currentPath.startsWith(path + '/');
};

const navLinks = [
  { href: `${import.meta.env.BASE_URL}cats`, label: 'Meet the cats' },
  { href: `${import.meta.env.BASE_URL}about`, label: 'About us' },
  { href: `${import.meta.env.BASE_URL}volunteer`, label: 'Volunteer' },
  { href: `${import.meta.env.BASE_URL}contact`, label: 'Contact' },
];
---

<nav>
  <a href="/" class="logo">Pawswick<span>Rescue</span></a>
  <ul>
    {navLinks.map(link => (
      <li>
        <a href={link.href} class={isActive(link.href) ? 'nav-active' : ''}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="nav-ctas">
    <a href={`${import.meta.env.BASE_URL}donate`} class="nav-btn nav-btn-secondary">Donate</a>
    <a href={`${import.meta.env.BASE_URL}adopt`} class="nav-btn nav-btn-primary">Adopt now</a>
  </div>
  <button class="menu-toggle" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navLinks = document.querySelector('nav ul');
  const navCtas = document.querySelector('.nav-ctas');

  menuToggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('active');
    navCtas?.classList.toggle('active');
    menuToggle.classList.toggle('active');
  });

  // Close menu when a link is clicked
  document.querySelectorAll('nav a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks?.classList.remove('active');
      navCtas?.classList.remove('active');
      menuToggle?.classList.remove('active');
    });
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 5%;
    background: rgba(255, 248, 240, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(242, 100, 48, 0.1);
  }

  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: #1C1C1C;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .logo span { color: #F26430; }

  ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  ul a {
    font-size: 0.95rem;
    font-weight: 500;
    color: #5A5A5A;
    text-decoration: none;
    transition: color 0.2s;
  }
  ul a:hover { color: #1C1C1C; }
  ul a.nav-active {
    color: #1C1C1C;
    position: relative;
  }
  ul a.nav-active::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0; right: 0;
    height: 2px;
    background: #F26430;
    border-radius: 2px;
  }

  .nav-ctas {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .nav-btn {
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s;
    border: 2px solid transparent;
  }

  .nav-btn-primary {
    background: #F26430;
    color: #fff;
  }
  .nav-btn-primary:hover { background: #E04A18; }

  .nav-btn-secondary {
    background: transparent;
    color: #1C1C1C;
    border-color: rgba(28, 28, 28, 0.18);
  }
  .nav-btn-secondary:hover { border-color: #1C1C1C; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #1C1C1C;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    ul {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(255, 248, 240, 0.95);
      backdrop-filter: blur(12px);
      flex-direction: column;
      gap: 0;
      list-style: none;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(242, 100, 48, 0.1);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    ul.active {
      max-height: 500px;
    }

    ul li {
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    ul a {
      display: block;
      padding: 1rem 5%;
    }

    .nav-ctas {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem 5%;
      background: rgba(255, 248, 240, 0.95);
      backdrop-filter: blur(12px);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .nav-ctas.active {
      max-height: 500px;
    }

    .nav-ctas a {
      width: 100%;
      text-align: center;
    }

    .menu-toggle { display: flex; }

    .menu-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(8px, 8px);
    }

    .menu-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -7px);
    }
  }
</style>