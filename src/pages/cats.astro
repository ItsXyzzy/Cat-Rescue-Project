---
import { getCollection } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const allCats = await getCollection('cats');

const available   = allCats.filter(c => c.data.status === 'Available');
const reserved    = allCats.filter(c => c.data.status === 'Pending');
const adopted     = allCats.filter(c => c.data.status === 'Adopted');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cats for Adoption &mdash; Pawswick Rescue</title>
  <meta name="theme-color" content="#FFF8F0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <Nav currentPath="/cats" />

  <!-- PAGE HEADER -->
  <header class="page-header">
    <div class="page-header-inner">
      <div class="page-header-text">
        <p class="eyebrow">Ready for homes</p>
        <h1>Meet our <em>cats</em></h1>
        <p class="page-sub">Every single one of them has a story. Take your time, browse their profiles, and see who catches your eye.</p>
      </div>
      <div class="header-count">
        <span class="count-num">{available.length}</span>
        <span class="count-label">cats available now</span>
      </div>
    </div>

    <!-- FILTER TABS -->
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="available">
        Available
        <span class="filter-chip">{available.length}</span>
      </button>
      <button class="filter-btn" data-filter="reserved">
        Reserved
        <span class="filter-chip chip-amber">{reserved.length}</span>
      </button>
      <button class="filter-btn" data-filter="adopted">
        Adopted
        <span class="filter-chip chip-muted">{adopted.length}</span>
      </button>
      <div class="filter-divider"></div>
      <button class="filter-btn" data-filter="kids">
        Good with kids
      </button>
      <button class="filter-btn" data-filter="quiet">
        Quiet home
      </button>
    </div>
  </header>

  <!-- MAIN GRID -->
  <main class="cats-main">

    <!-- AVAILABLE -->
    <section class="cat-group" data-group="available">
      <div class="cat-grid">
        {available.map((cat, i) => (
          <article
            class="cat-card"
            data-kids={cat.data.goodWithKids ? 'true' : 'false'}
            data-status="available"
            style={`animation-delay: ${i * 0.06}s`}
          >
            <a href={`/cats/${cat.id}`} class="card-link" tabindex="-1" aria-hidden="true">
              <div class="card-img">
                <img src={cat.data.image} alt={cat.data.name} loading="lazy" />
                <span class="age-pill">{cat.data.age}</span>
                <div class="card-img-overlay">
                  <span>View profile</span>
                </div>
              </div>
            </a>
            <div class="card-body">
              <div class="card-top">
                <h2><a href={`/cats/${cat.id}`}>{cat.data.name}</a></h2>
                <span class={`trait-badge ${cat.data.goodWithKids ? 'trait-green' : 'trait-amber'}`}>
                  {cat.data.goodWithKids ? 'Great with kids' : 'Quiet home'}
                </span>
              </div>
              {cat.data.description && <p class="card-desc">{cat.data.description}</p>}
              <a href={`/cats/${cat.id}`} class="card-cta">Meet {cat.data.name}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- RESERVED -->
    {reserved.length > 0 && (
      <section class="cat-group reserved-group" data-group="reserved" style="display:none">
        <div class="group-notice">
          <strong>These cats are reserved</strong> &mdash; they have a pending adoption but aren't officially homed yet. If it falls through, they'll be back as available.
        </div>
        <div class="cat-grid">
          {reserved.map((cat, i) => (
            <article
              class="cat-card card-reserved"
              data-kids={cat.data.goodWithKids ? 'true' : 'false'}
              data-status="reserved"
              style={`animation-delay: ${i * 0.06}s`}
            >
              <div class="card-img">
                <img src={cat.data.image} alt={cat.data.name} loading="lazy" />
                <span class="age-pill">{cat.data.age}</span>
                <span class="status-overlay status-reserved">Reserved</span>
              </div>
              <div class="card-body">
                <div class="card-top">
                  <h2>{cat.data.name}</h2>
                  <span class={`trait-badge ${cat.data.goodWithKids ? 'trait-green' : 'trait-amber'}`}>
                    {cat.data.goodWithKids ? 'Great with kids' : 'Quiet home'}
                  </span>
                </div>
                {cat.data.description && <p class="card-desc">{cat.data.description}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ADOPTED -->
    {adopted.length > 0 && (
      <section class="cat-group adopted-group" data-group="adopted" style="display:none">
        <div class="group-notice group-notice-green">
          <strong>These cats found their forever homes.</strong> Every one of them is living their best life right now.
        </div>
        <div class="cat-grid">
          {adopted.map((cat, i) => (
            <article
              class="cat-card card-adopted"
              data-kids={cat.data.goodWithKids ? 'true' : 'false'}
              data-status="adopted"
              style={`animation-delay: ${i * 0.06}s`}
            >
              <div class="card-img">
                <img src={cat.data.image} alt={cat.data.name} loading="lazy" />
                <span class="age-pill">{cat.data.age}</span>
                <span class="status-overlay status-adopted">Rehomed</span>
              </div>
              <div class="card-body">
                <div class="card-top">
                  <h2>{cat.data.name}</h2>
                </div>
                {cat.data.description && <p class="card-desc">{cat.data.description}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- EMPTY STATE -->
    <div class="empty-state" style="display:none">
      <p class="empty-icon">&#x1F43F;</p>
      <h3>No cats match that filter</h3>
      <p>Try a different filter or <a href="/cats">view all cats</a>.</p>
    </div>

  </main>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="cta-inner">
      <div>
        <p class="eyebrow eyebrow-light">Not sure yet?</p>
        <h2>Come and meet them in person</h2>
        <p>There's no commitment to a visit. We're open every day 10am&ndash;5pm and love showing people around.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary btn-large">Get in touch</a>
        <a href="/adopt" class="btn-ghost">How to adopt</a>
      </div>
    </div>
  </section>

  <Footer />

</body>
</html>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const groups     = document.querySelectorAll<HTMLElement>('.cat-group');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');
  const cards      = document.querySelectorAll<HTMLElement>('.cat-card');

  let activeGroup  = 'available';
  let activeSubset = 'all'; // 'all' | 'kids' | 'quiet'

  function applyFilters() {
    // Show/hide group sections
    groups.forEach(g => {
      const show = g.dataset.group === activeGroup;
      (g as HTMLElement).style.display = show ? '' : 'none';
    });

    // Within the active group, apply subset filter
    let visibleCount = 0;
    cards.forEach(card => {
      if (card.dataset.status !== activeGroup) return;
      let show = true;
      if (activeSubset === 'kids')  show = card.dataset.kids === 'true';
      if (activeSubset === 'quiet') show = card.dataset.kids === 'false';
      card.style.display = show ? '' : 'none';
      card.style.animation = show ? '' : 'none';
      if (show) visibleCount++;
    });

    emptyState!.style.display = visibleCount === 0 ? '' : 'none';
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      const isGroup  = ['available', 'reserved', 'adopted'].includes(f);
      const isSubset = ['kids', 'quiet'].includes(f);

      // Deactivate all
      filterBtns.forEach(b => b.classList.remove('active'));

      if (isGroup) {
        activeGroup  = f;
        activeSubset = 'all';
        btn.classList.add('active');
      } else if (isSubset) {
        // Toggle subset
        if (activeSubset === f) {
          activeSubset = 'all';
        } else {
          activeSubset = f;
          btn.classList.add('active');
        }
        // Re-highlight the current group btn
        document.querySelector(`[data-filter="${activeGroup}"]`)?.classList.add('active');
      }

      applyFilters();
    });
  });
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:   #FFF8F0;
    --cream2:  #FFF0E0;
    --orange:  #F26430;
    --orange2: #E04A18;
    --charcoal:#1C1C1C;
    --mid:     #5A5A5A;
    --muted:   #9A8E85;
    --green:   #2D7D4F;
    --green-bg:#E6F4ED;
    --amber:   #B45309;
    --amber-bg:#FEF3C7;
    --sand:    #F5EDE3;
    --radius:  16px;
    --radius-sm: 8px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* EYEBROW */
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.6rem;
  }
  .eyebrow-light { color: rgba(242, 100, 48, 0.75); }

  /* PAGE HEADER */
  .page-header {
    background: var(--charcoal);
    padding: 4rem 5% 0;
  }

  .page-header-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }

  .page-header-text h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
  }
  .page-header-text h1 em {
    font-style: italic;
    color: var(--orange);
  }

  .page-sub {
    margin-top: 0.8rem;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.55);
    max-width: 480px;
  }

  .header-count {
    text-align: right;
    flex-shrink: 0;
  }
  .count-num {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 4rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .count-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* FILTER BAR */
  .filter-bar {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding-bottom: 0;
    overflow-x: auto;
    scrollbar-width: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1rem;
  }
  .filter-bar::-webkit-scrollbar { display: none; }

  .filter-divider {
    width: 1px;
    height: 20px;
    background: rgba(255,255,255,0.15);
    margin: 0 0.25rem;
    flex-shrink: 0;
  }

  .filter-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 100px 100px 0 0;
    border: 1px solid transparent;
    border-bottom: none;
    background: transparent;
    color: rgba(255,255,255,0.5);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  .filter-btn:hover { color: rgba(255,255,255,0.85); }
  .filter-btn.active {
    background: var(--cream);
    color: var(--charcoal);
    border-color: rgba(255,255,255,0.1);
  }

  .filter-chip {
    background: var(--orange);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 100px;
    line-height: 1.6;
  }
  .chip-amber { background: #D97706; }
  .chip-muted { background: rgba(255,255,255,0.2); }

  /* MAIN */
  .cats-main {
    max-width: 1300px;
    margin: 0 auto;
    padding: 3rem 5% 5rem;
  }

  .group-notice {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: var(--radius-sm);
    padding: 1rem 1.4rem;
    font-size: 0.9rem;
    color: var(--mid);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .group-notice strong { color: var(--charcoal); }
  .group-notice-green { border-left: 3px solid var(--green); }

  /* CAT GRID */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .cat-card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.06);
    opacity: 0;
    transform: translateY(16px);
    animation: card-in 0.5s ease forwards;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }
  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }

  @keyframes card-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Reserved / Adopted card tones */
  .card-reserved { opacity: 0.7; }
  .card-reserved:hover { transform: none; box-shadow: none; cursor: default; }

  .card-adopted { filter: grayscale(0.6); opacity: 0.65; }
  .card-adopted:hover { transform: none; box-shadow: none; cursor: default; }

  /* Card Image */
  .card-img {
    position: relative;
    height: 260px;
    overflow: hidden;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cat-card:hover .card-img img { transform: scale(1.05); }
  .card-reserved:hover .card-img img,
  .card-adopted:hover .card-img img { transform: none; }

  .card-link { display: block; }

  .card-img-overlay {
    position: absolute;
    inset: 0;
    background: rgba(242, 100, 48, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .card-img-overlay span {
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .cat-card:hover .card-img-overlay { opacity: 1; }
  .card-reserved:hover .card-img-overlay,
  .card-adopted:hover .card-img-overlay { opacity: 0; }

  .age-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--charcoal);
  }

  .status-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .status-reserved { background: var(--amber-bg); color: var(--amber); }
  .status-adopted  { background: var(--green-bg); color: var(--green); }

  /* Card Body */
  .card-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.8rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-top h2 {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .card-top h2 a {
    color: var(--charcoal);
    text-decoration: none;
    transition: color 0.15s;
  }
  .card-top h2 a:hover { color: var(--orange); }

  .trait-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .trait-green { background: var(--green-bg); color: var(--green); }
  .trait-amber { background: var(--amber-bg); color: var(--amber); }

  .card-desc {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    display: block;
    text-align: center;
    margin-top: auto;
    padding: 0.75rem;
    background: var(--sand);
    border-radius: var(--radius-sm);
    color: var(--charcoal);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .card-cta:hover { background: var(--orange); color: #fff; }

  /* EMPTY STATE */
  .empty-state {
    padding: 5rem 2rem;
    text-align: center;
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .empty-state h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .empty-state p {
    color: var(--mid);
    font-size: 0.95rem;
  }
  .empty-state a { color: var(--orange); }

  /* CTA BAND */
  .cta-band {
    background: var(--charcoal);
    padding: 5rem 5%;
  }

  .cta-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-inner h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .cta-inner p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    max-width: 440px;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* BUTTONS */
  .btn-primary {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-primary:hover { background: var(--orange2); transform: translateY(-2px); }
  .btn-large { padding: 1rem 2.4rem; font-size: 1.05rem; }

  .btn-ghost {
    display: inline-block;
    background: transparent;
    color: #fff;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid rgba(255,255,255,0.25);
    transition: border-color 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-ghost:hover { border-color: #fff; transform: translateY(-2px); }

  /* RESPONSIVE */
  @media (max-width: 860px) {
    .page-header-inner { flex-direction: column; align-items: flex-start; }
    .header-count { text-align: left; }
    .cta-inner { flex-direction: column; }
  }

  @media (max-width: 600px) {
    nav ul { display: none; }
    .menu-toggle { display: flex; }
    .cat-grid { grid-template-columns: 1fr; }
    .cta-actions { width: 100%; }
    .footer-inner { flex-direction: column; text-align: center; }
    .footer-links { justify-content: center; }
  }
</style>
