---
import { getCollection } from 'astro:content';
import CatCard from '../../components/CatCard.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro'; 

export async function getStaticPaths() {
  const cats = await getCollection('cats');
  return cats.map(cat => ({
    params: { id: cat.id },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const { name, age, image, goodWithKids, status } = cat.data;

const isAvailable = status === 'Available';
const statusLabel = status === 'Pending' ? 'Reserved' : status === 'Adopted' ? 'Adopted' : 'Available';
const statusColor = status === 'Available' ? 'status-green' : status === 'Adopted' ? 'status-gray' : 'status-amber';

// Fetch all cats
const allCats = await getCollection('cats');

// Filter for OTHER cats that are currently "Available"
const otherAvailableCats = allCats.filter(c => 
  c.id !== cat.id && c.data.status === 'Available'
);

// Shuffle them and grab up to 3
const displayCats = otherAvailableCats
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name} &mdash; Pawswick Rescue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <Nav currentPath="/cats" />

  <!-- BREADCRUMB -->
  <nav class="breadcrumb">
    <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cats`}>All cats</a>
    <span>/</span>
    <span>{name}</span>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-image">
      <img src={image} alt={name} />
      <div class={`status-badge ${statusColor}`}>
        <span class="status-dot"></span>
        {statusLabel}
      </div>
    </div>
    <div class="hero-info">
      <div class="info-inner">
        <p class="eyebrow">Meet</p>
        <h1>{name}</h1>
        
        <div class="cat-meta">
          <div class="meta-item">
            <span class="meta-label">Age</span>
            <span class="meta-value">{age}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Good with kids</span>
            <span class="meta-value">{goodWithKids ? 'Yes' : 'Prefers quiet home'}</span>
          </div>
        </div>

        <div class="story" set:html={cat.body}>
</div>

        {isAvailable ? (
          <div class="action-section">
            <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}adopt`} class="btn-primary btn-large">Start adoption</a>
            <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}contact`} class="btn-ghost">Visit {name}</a>
          </div>
        ) : (
          <div class="unavailable-section">
            <p>{name} is currently {statusLabel === 'Adopted' ? 'in their forever home' : 'pending adoption'}. But there are lots of other amazing cats waiting for you!</p>
            <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cats`} class="btn-primary">See other cats</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="more-cats">
  <div class="more-cats-inner">
    <h2>Other cats looking for homes</h2>
    
    {displayCats.length > 0 ? (
      <div class="more-grid">
        {displayCats.map((c) => (
          <CatCard 
            id={c.id}
            name={c.data.name}
            age={c.data.age}
            image={c.data.image}
            status={c.data.status}
            goodWithKids={c.data.goodWithKids}
            description={c.data.description}
          />
        ))}
      </div>
    ) : (
      <div class="more-grid">
        <div class="placeholder">
          <p>All our other sweet residents currently have adoptions pending!</p>
          <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cats`}>View adoption center</a>
        </div>
      </div>
    )}
  </div>
</section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="cta-inner">
      <div>
        <p class="eyebrow eyebrow-light">Not sure yet?</p>
        <h2>Come and meet {name} in person</h2>
        <p>We're open every day 10am–5pm. No commitment needed, just come by for a visit.</p>
      </div>
      <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}contact`} class="btn-primary btn-large">Get in touch</a>
    </div>
  </section>

  <Footer />

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:   #FFF8F0;
    --cream2:  #FFF0E0;
    --orange:  #F26430;
    --orange2: #E04A18;
    --charcoal:#1C1C1C;
    --mid:     #5A5A5A;
    --muted:   #9A8E85;
    --green:   #2D7D4F;
    --green-bg:#E6F4ED;
    --amber:   #B45309;
    --amber-bg:#FEF3C7;
    --sand:    #F5EDE3;
    --radius:  16px;
    --radius-sm: 8px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* BREADCRUMB */
  .breadcrumb {
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.5rem 5%;
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-size: 0.9rem;
    color: var(--mid);
  }
  .breadcrumb a {
    color: var(--orange);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover { color: var(--orange2); }

  /* EYEBROW */
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.6rem;
  }
  .eyebrow-light { color: rgba(242, 100, 48, 0.75); }

  /* HERO */
  .hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 5%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 70vh;
  }

  .hero-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(242, 100, 48, 0.15);
    animation: fade-in 0.7s ease 0.1s both;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .status-green { background: rgba(45, 125, 79, 0.15); color: var(--green); }
  .status-green .status-dot { background: var(--green); animation: pulse-dot 2s ease infinite; }

  .status-amber { background: rgba(180, 83, 9, 0.15); color: var(--amber); }
  .status-amber .status-dot { background: var(--amber); }

  .status-gray { background: rgba(0, 0, 0, 0.1); color: var(--mid); }
  .status-gray .status-dot { background: var(--mid); }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 2px rgba(45, 125, 79, 0.25); }
    50%       { box-shadow: 0 0 0 6px rgba(45, 125, 79, 0.1); }
  }

  .hero-info {
    animation: fade-in 0.7s ease 0.2s both;
  }

  .info-inner {
    max-width: 520px;
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 2rem;
  }

  /* CAT META */
  .cat-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(28, 28, 28, 0.1);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .meta-value {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--charcoal);
  }

  /* STORY */
  .story {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--mid);
    margin-bottom: 2.5rem;
  }

  .story :deep(p) {
    margin-bottom: 1.2rem;
  }

  .story :deep(p:last-child) {
    margin-bottom: 0;
  }

  /* ACTIONS */
  .action-section,
  .unavailable-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .unavailable-section p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--mid);
    margin-bottom: 1rem;
  }

  /* BUTTONS */
  .btn-primary {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
    text-align: center;
  }
  .btn-primary:hover { background: var(--orange2); transform: translateY(-2px); }
  .btn-large { padding: 1rem 2.4rem; font-size: 1.05rem; }

  .btn-ghost {
    display: inline-block;
    background: transparent;
    color: var(--charcoal);
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid rgba(28, 28, 28, 0.18);
    transition: border-color 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-ghost:hover { border-color: var(--charcoal); transform: translateY(-2px); }

  /* MORE CATS SECTION & LAYOUT */
.more-cats {
  background: var(--charcoal);
  padding: 5rem 5%;
}

.more-cats-inner {
  max-width: 1300px;
  margin: 0 auto;
}

.more-cats h2 {
  font-family: 'Fraunces', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.03em;
  margin-bottom: 3rem;
}

.more-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

/* FALLBACK PLACEHOLDER */
.placeholder {
  grid-column: 1 / -1;
  padding: 4rem 2rem;
  background: rgba(255,255,255,0.05);
  border-radius: var(--radius);
  border: 1px solid rgba(255,255,255,0.1);
  text-align: center;
}
.placeholder p {
  color: rgba(255,255,255,0.4);
  font-size: 0.9rem;
  margin-bottom: 1rem;
}
.placeholder a {
  color: var(--orange);
  font-weight: 600;
  text-decoration: none;
}
  /* CTA BAND */
  .cta-band {
    background: var(--charcoal);
    padding: 5rem 5%;
  }

  .cta-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-inner h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .cta-inner p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    max-width: 440px;
  }

  /* ANIMATIONS */
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: unset;
      gap: 2.5rem;
      text-align: center;
    }
    .info-inner { max-width: 100%; }
    .cat-meta { grid-template-columns: 1fr; }
    .action-section,
    .unavailable-section { align-items: center; }
    .cta-inner { flex-direction: column; }
  }

  @media (max-width: 600px) {
    .breadcrumb { font-size: 0.8rem; padding: 1rem 5%; }
  }
</style>
