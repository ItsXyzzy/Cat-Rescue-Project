---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Donate &mdash; Pawswick Rescue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <Nav currentPath="/donate" />

  <!-- HERO -->
  <header class="page-header">
    <div class="page-header-inner">
      <div class="header-text">
        <p class="eyebrow">Make a difference</p>
        <h1>Every euro <em>counts</em></h1>
        <p class="page-sub">We're a registered charity run almost entirely by volunteers. Every donation goes directly to the cats in our care — food, vet bills, medicines, and keeping the shelter running.</p>
      </div>
      <div class="impact-strip">
        <div class="impact-item">
          <span class="impact-num">&euro;10</span>
          <span class="impact-label">feeds a cat for a month</span>
        </div>
        <div class="impact-divider"></div>
        <div class="impact-item">
          <span class="impact-num">&euro;25</span>
          <span class="impact-label">covers a vet check-up</span>
        </div>
        <div class="impact-divider"></div>
        <div class="impact-item">
          <span class="impact-num">&euro;50</span>
          <span class="impact-label">pays for vaccinations</span>
        </div>
        <div class="impact-divider"></div>
        <div class="impact-item">
          <span class="impact-num">&euro;100</span>
          <span class="impact-label">sponsors a full rescue</span>
        </div>
      </div>
    </div>
  </header>

  <!-- DONATION WIDGET -->
  <section class="donate-section">
    <div class="donate-inner">

      <div class="donate-widget">
        <div class="widget-header">
          <!-- FREQUENCY TOGGLE -->
          <div class="freq-toggle">
            <button class="freq-btn active" data-freq="monthly">Give monthly</button>
            <button class="freq-btn" data-freq="once">Give once</button>
          </div>
          <p class="toggle-nudge">Monthly giving goes further &mdash; it helps us plan ahead.</p>
        </div>

        <!-- AMOUNT TIERS -->
        <div class="tiers">
          <button class="tier" data-amount="5">
            <span class="tier-amount">&euro;5</span>
            <span class="tier-impact">Litter & bedding</span>
          </button>
          <button class="tier active" data-amount="10">
            <span class="tier-amount">&euro;10</span>
            <span class="tier-impact">Food for a month</span>
          </button>
          <button class="tier" data-amount="25">
            <span class="tier-amount">&euro;25</span>
            <span class="tier-impact">Vet check-up</span>
          </button>
          <button class="tier" data-amount="50">
            <span class="tier-amount">&euro;50</span>
            <span class="tier-impact">Vaccinations</span>
          </button>
          <button class="tier" data-amount="100">
            <span class="tier-amount">&euro;100</span>
            <span class="tier-impact">Sponsor a rescue</span>
          </button>
          <button class="tier tier-custom" data-amount="custom">
            <span class="tier-amount">Other</span>
            <span class="tier-impact">Your amount</span>
          </button>
        </div>

        <!-- CUSTOM AMOUNT -->
        <div class="custom-amount-wrap" style="display:none">
          <label for="custom-input">Enter your amount (&euro;)</label>
          <div class="custom-input-row">
            <span class="currency-symbol">&euro;</span>
            <input type="number" id="custom-input" min="1" placeholder="0" />
          </div>
        </div>

        <!-- SUMMARY -->
        <div class="donate-summary">
          <p class="summary-text">
            You're donating <strong class="summary-amount">&euro;10</strong>
            <strong class="summary-freq">per month</strong>
          </p>
          <p class="summary-sub">to Pawswick Rescue. Thank you &mdash; it genuinely makes a difference.</p>
        </div>

        <a href="#" class="btn-primary btn-large btn-donate">Donate now</a>
        <p class="secure-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Secure payment. We never store your card details.
        </p>
      </div>

      <!-- SIDEBAR -->
      <aside class="donate-sidebar">
        <h2>Where your money goes</h2>

        <div class="spend-breakdown">
          <div class="spend-item">
            <div class="spend-header">
              <span class="spend-label">Veterinary care</span>
              <span class="spend-pct">42%</span>
            </div>
            <div class="spend-bar"><div class="spend-fill" style="width: 42%"></div></div>
            <p>Check-ups, medicines, emergency treatment, neutering, and microchipping for every cat that comes through our doors.</p>
          </div>
          <div class="spend-item">
            <div class="spend-header">
              <span class="spend-label">Food & supplies</span>
              <span class="spend-pct">28%</span>
            </div>
            <div class="spend-bar"><div class="spend-fill" style="width: 28%"></div></div>
            <p>High-quality food, litter, bedding, toys, and enrichment for up to 30 cats at any one time.</p>
          </div>
          <div class="spend-item">
            <div class="spend-header">
              <span class="spend-label">Shelter running costs</span>
              <span class="spend-pct">20%</span>
            </div>
            <div class="spend-bar"><div class="spend-fill" style="width: 20%"></div></div>
            <p>Heating, electricity, cleaning, and basic maintenance to keep the shelter safe and comfortable.</p>
          </div>
          <div class="spend-item">
            <div class="spend-header">
              <span class="spend-label">Rescue & transport</span>
              <span class="spend-pct">10%</span>
            </div>
            <div class="spend-bar"><div class="spend-fill" style="width: 10%"></div></div>
            <p>Fuel costs, carriers, and equipment for bringing cats in from stray situations or owner surrenders.</p>
          </div>
        </div>

        <div class="annual-note">
          <p>Our full annual accounts are available on request. We believe in complete transparency.</p>
          <a href={`${import.meta.env.BASE_URL}contact`} class="link-orange">Request our accounts &rarr;</a>
        </div>
      </aside>

    </div>
  </section>

  <!-- OTHER WAYS TO HELP -->
  <section class="other-ways">
    <div class="other-ways-inner">
      <p class="eyebrow">Can't donate right now?</p>
      <h2>Other ways to support us</h2>
      <div class="ways-grid">
        <a href={`${import.meta.env.BASE_URL}volunteer`} class="way-card">
          <div class="way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </div>
          <div>
            <h3>Volunteer your time</h3>
            <p>A few hours a week makes a world of difference to the cats in our care.</p>
          </div>
          <span class="way-arrow">&rarr;</span>
        </a>
        <a href={`${import.meta.env.BASE_URL}volunteer#foster`} class="way-card">
          <div class="way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <div>
            <h3>Become a foster carer</h3>
            <p>Give a cat a warm home while they wait for their forever family. We cover all costs.</p>
          </div>
          <span class="way-arrow">&rarr;</span>
        </a>
        <a href={`${import.meta.env.BASE_URL}cats`} class="way-card">
          <div class="way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          </div>
          <div>
            <h3>Spread the word</h3>
            <p>Share our cats on social media. Every share could lead to a forever home.</p>
          </div>
          <span class="way-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />

</body>
</html>

<script>
  // FREQUENCY TOGGLE
  const freqBtns = document.querySelectorAll<HTMLButtonElement>('.freq-btn');
  const toggleNudge = document.querySelector<HTMLElement>('.toggle-nudge');
  const summaryFreq = document.querySelector<HTMLElement>('.summary-freq');
  let currentFreq = 'monthly';

  freqBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      freqBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFreq = btn.dataset.freq!;
      summaryFreq!.textContent = currentFreq === 'monthly' ? 'per month' : 'one-off';
      toggleNudge!.style.opacity = currentFreq === 'monthly' ? '1' : '0';
      updateSummary();
    });
  });

  // TIER SELECTION
  const tiers = document.querySelectorAll<HTMLButtonElement>('.tier');
  const customWrap = document.querySelector<HTMLElement>('.custom-amount-wrap');
  const customInput = document.querySelector<HTMLInputElement>('#custom-input');
  const summaryAmount = document.querySelector<HTMLElement>('.summary-amount');
  let currentAmount: number | null = 10;

  function updateSummary() {
    const display = currentAmount !== null ? `€${currentAmount}` : '€--';
    summaryAmount!.textContent = display;
  }

  tiers.forEach(tier => {
    tier.addEventListener('click', () => {
      tiers.forEach(t => t.classList.remove('active'));
      tier.classList.add('active');

      if (tier.dataset.amount === 'custom') {
        customWrap!.style.display = '';
        currentAmount = null;
        customInput!.focus();
      } else {
        customWrap!.style.display = 'none';
        currentAmount = Number(tier.dataset.amount);
      }
      updateSummary();
    });
  });

  customInput?.addEventListener('input', () => {
    currentAmount = customInput.value ? Number(customInput.value) : null;
    updateSummary();
  });
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:    #FFF8F0;
    --cream2:   #FFF0E0;
    --orange:   #F26430;
    --orange2:  #E04A18;
    --charcoal: #1C1C1C;
    --mid:      #5A5A5A;
    --muted:    #9A8E85;
    --green:    #2D7D4F;
    --green-bg: #E6F4ED;
    --sand:     #F5EDE3;
    --radius:   16px;
    --radius-sm: 8px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* NAV */

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.6rem;
  }

  /* HEADER */
  .page-header {
    background: var(--charcoal);
    padding: 5rem 5% 0;
  }

  .page-header-inner {
    max-width: 1300px;
    margin: 0 auto;
  }

  .header-text {
    max-width: 600px;
    padding-bottom: 3rem;
  }

  .header-text h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 1.2rem;
  }
  .header-text h1 em { font-style: italic; color: var(--orange); }

  .page-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
  }

  /* IMPACT STRIP */
  .impact-strip {
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2rem 0;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .impact-strip::-webkit-scrollbar { display: none; }

  .impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0 3rem 0 0;
    flex-shrink: 0;
  }

  .impact-num {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .impact-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    font-weight: 500;
  }

  .impact-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    margin-right: 3rem;
  }

  /* DONATE SECTION */
  .donate-section {
    padding: 5rem 5%;
  }

  .donate-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* WIDGET */
  .donate-widget {
    background: #fff;
    border-radius: var(--radius);
    border: 1px solid rgba(0, 0, 0, 0.07);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 6rem;
  }

  .widget-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* FREQUENCY TOGGLE */
  .freq-toggle {
    display: flex;
    background: var(--cream2);
    border-radius: 100px;
    padding: 4px;
    gap: 4px;
    width: fit-content;
  }

  .freq-btn {
    padding: 0.55rem 1.4rem;
    border-radius: 100px;
    border: none;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--mid);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .freq-btn.active {
    background: var(--charcoal);
    color: #fff;
  }

  .toggle-nudge {
    font-size: 0.8rem;
    color: var(--orange);
    font-weight: 500;
    transition: opacity 0.3s;
  }

  /* TIERS */
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .tier {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 2px solid rgba(0, 0, 0, 0.08);
    background: var(--cream);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
  }
  .tier:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .tier.active {
    border-color: var(--orange);
    background: rgba(242, 100, 48, 0.06);
  }

  .tier-amount {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--charcoal);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .tier.active .tier-amount { color: var(--orange); }

  .tier-impact {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
    text-align: center;
    line-height: 1.3;
  }

  .tier.active .tier-impact { color: var(--orange); opacity: 0.8; }

  /* CUSTOM AMOUNT */
  .custom-amount-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .custom-amount-wrap label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--charcoal);
  }

  .custom-input-row {
    display: flex;
    align-items: center;
    border: 2px solid var(--orange);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--cream);
  }

  .currency-symbol {
    padding: 0.85rem 0.8rem 0.85rem 1rem;
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--orange);
  }

  .custom-input-row input {
    border: none;
    background: transparent;
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--charcoal);
    width: 100%;
    padding: 0.7rem 1rem 0.7rem 0;
    outline: none;
  }

  /* SUMMARY */
  .donate-summary {
    background: var(--cream2);
    border-radius: var(--radius-sm);
    padding: 1.2rem 1.4rem;
    border-left: 3px solid var(--orange);
  }

  .summary-text {
    font-size: 1rem;
    color: var(--charcoal);
    margin-bottom: 0.3rem;
  }

  .summary-amount,
  .summary-freq { color: var(--orange); }

  .summary-sub {
    font-size: 0.85rem;
    color: var(--mid);
    line-height: 1.5;
  }

  .btn-donate {
    width: 100%;
    text-align: center;
  }

  .secure-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* SIDEBAR */
  .donate-sidebar h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
  }

  .spend-breakdown {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    margin-bottom: 2rem;
  }

  .spend-item { display: flex; flex-direction: column; gap: 0.5rem; }

  .spend-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .spend-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--charcoal);
  }

  .spend-pct {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--orange);
  }

  .spend-bar {
    height: 6px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 100px;
    overflow: hidden;
  }

  .spend-fill {
    height: 100%;
    background: var(--orange);
    border-radius: 100px;
    animation: bar-in 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes bar-in {
    from { width: 0 !important; }
  }

  .spend-item p {
    font-size: 0.875rem;
    color: var(--mid);
    line-height: 1.65;
  }

  .annual-note {
    background: var(--green-bg);
    border-radius: var(--radius-sm);
    padding: 1.2rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 3px solid var(--green);
  }

  .annual-note p {
    font-size: 0.875rem;
    color: var(--green);
    line-height: 1.6;
  }

  .link-orange {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--orange);
    text-decoration: none;
    transition: color 0.2s;
  }
  .link-orange:hover { color: var(--orange2); }

  /* OTHER WAYS */
  .other-ways {
    background: var(--charcoal);
    padding: 5rem 5%;
  }

  .other-ways-inner {
    max-width: 1300px;
    margin: 0 auto;
  }

  .other-ways h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.03em;
    margin-bottom: 2.5rem;
  }

  .ways-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .way-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .way-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(242, 100, 48, 0.4);
    transform: translateY(-4px);
  }

  .way-icon {
    width: 48px;
    height: 48px;
    background: rgba(242, 100, 48, 0.12);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
  }

  .way-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .way-card p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.65;
    flex-grow: 1;
    margin: 0;
  }

  .way-arrow {
    font-size: 1.1rem;
    color: var(--orange);
    transition: transform 0.2s;
  }
  .way-card:hover .way-arrow { transform: translateX(4px); }

  /* BUTTONS */
  .btn-primary {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    font-family: 'DM Sans', sans-serif;
    border: none;
    cursor: pointer;
  }
  .btn-primary:hover { background: var(--orange2); transform: translateY(-2px); }
  .btn-large { padding: 1rem 2.4rem; font-size: 1.05rem; }

  /* RESPONSIVE */
  @media (max-width: 1000px) {
    .donate-inner { grid-template-columns: 1fr; }
    .donate-widget { position: static; }
    .ways-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .tiers { grid-template-columns: repeat(2, 1fr); }
