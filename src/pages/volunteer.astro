---

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Volunteer &mdash; Pawswick Rescue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="logo">Pawswick<span>Rescue</span></a>
    <ul>
      <li><a href="/cats">Meet the cats</a></li>
      <li><a href="/about">About us</a></li>
      <li><a href="/volunteer" class="nav-active">Volunteer</a></li>
      <li><a href="/adopt" class="nav-cta">Adopt now</a></li>
    </ul>
    <button class="menu-toggle" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- HERO -->
  <header class="page-header">
    <div class="page-header-inner">
      <div class="header-text">
        <p class="eyebrow">Join our team</p>
        <h1>Run on good <em>people</em></h1>
        <p class="page-sub">We're a small, volunteer-led rescue. Without the people who give their time, we simply couldn't do what we do. If you've got a few hours to spare and a soft spot for cats, we'd love to have you.</p>
        <a href="#apply" class="btn-primary btn-large">Get involved</a>
      </div>
      <div class="header-stat-stack">
        <div class="header-stat">
          <span class="stat-num">40+</span>
          <span class="stat-label">Active volunteers</span>
        </div>
        <div class="header-stat header-stat-offset">
          <span class="stat-num">6hrs</span>
          <span class="stat-label">Average per week</span>
        </div>
        <div class="header-stat">
          <span class="stat-num">12yrs</span>
          <span class="stat-label">Running strong</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ROLES SECTION -->
  <section class="roles-section">
    <div class="roles-inner">
      <div class="section-label">
        <p class="eyebrow">Ways to help</p>
        <h2>Find your role</h2>
        <p class="section-sub">No experience needed for most roles. Just enthusiasm and reliability. We'll train you up on everything else.</p>
      </div>

      <div class="roles-grid">
        <div class="role-card role-card-large">
          <div class="role-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </div>
          <h3>Socialisation & care</h3>
          <p>Spend time with our cats, help with feeding, grooming, and general enrichment. This is the heartbeat of the shelter. Cats need human interaction daily, and this is where our volunteers make the biggest difference.</p>
          <div class="role-meta">
            <span class="role-tag">2&ndash;4 hrs/week</span>
            <span class="role-tag">Shelter-based</span>
            <span class="role-tag">No experience needed</span>
          </div>
        </div>

        <div class="role-card role-card-large">
          <div class="role-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <h3>Foster carer</h3>
          <p>Give a cat (or a litter of kittens) a warm, quiet home while they wait for adoption. Fostering is huge for anxious or unwell cats who don't thrive in a shelter environment. We cover all food and vet costs.</p>
          <div class="role-meta">
            <span class="role-tag">Short or long term</span>
            <span class="role-tag">Home-based</span>
            <span class="role-tag">Full support provided</span>
          </div>
        </div>

        <div class="role-card">
          <div class="role-icon-wrap role-icon-sm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <h3>Events & fundraising</h3>
          <p>Help us run adoption days, charity events, and community drives that keep the lights on.</p>
          <div class="role-meta">
            <span class="role-tag">Flexible</span>
            <span class="role-tag">Occasional</span>
          </div>
        </div>

        <div class="role-card">
          <div class="role-icon-wrap role-icon-sm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <h3>Social media & photography</h3>
          <p>Help us photograph cats for adoption listings and manage our social presence. Great cats deserve great photos.</p>
          <div class="role-meta">
            <span class="role-tag">Remote-friendly</span>
            <span class="role-tag">Flexible</span>
          </div>
        </div>

        <div class="role-card">
          <div class="role-icon-wrap role-icon-sm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          </div>
          <h3>Admin & coordination</h3>
          <p>Help manage adoption enquiries, coordinate volunteers, and keep the admin side of the rescue ticking over.</p>
          <div class="role-meta">
            <span class="role-tag">Remote-friendly</span>
            <span class="role-tag">3&ndash;5 hrs/week</span>
          </div>
        </div>

        <div class="role-card">
          <div class="role-icon-wrap role-icon-sm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <h3>Transport & vet runs</h3>
          <p>Drive cats to and from vet appointments or between foster homes. Flexible scheduling, huge help.</p>
          <div class="role-meta">
            <span class="role-tag">Car required</span>
            <span class="role-tag">Ad hoc</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="expect-section">
    <div class="expect-inner">
      <div class="expect-text">
        <p class="eyebrow">Joining up</p>
        <h2>What to expect</h2>
        <p>We keep things simple. No mountains of paperwork, no weeks of waiting. You fill in the form, we have a quick chat, and if it's a good fit you'll be in the shelter before you know it.</p>

        <div class="expect-steps">
          <div class="expect-step">
            <span class="step-num">01</span>
            <div>
              <strong>Fill in the form</strong>
              <p>Tell us a bit about yourself and what you're interested in.</p>
            </div>
          </div>
          <div class="expect-step">
            <span class="step-num">02</span>
            <div>
              <strong>Quick chat with us</strong>
              <p>A casual 20-minute call to make sure it's a good match.</p>
            </div>
          </div>
          <div class="expect-step">
            <span class="step-num">03</span>
            <div>
              <strong>Induction visit</strong>
              <p>Come in, meet the team, meet the cats, get the lay of the land.</p>
            </div>
          </div>
          <div class="expect-step">
            <span class="step-num">04</span>
            <div>
              <strong>You're one of us</strong>
              <p>Pick your shifts, get added to the group chat, and off you go.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="expect-aside">
        <div class="quote-card">
          <p class="quote-text">"I started volunteering at Pawswick three years ago and honestly it's become one of my favourite parts of the week. The team is brilliant and the cats are even better."</p>
          <div class="quote-author">
            <div class="author-avatar">S</div>
            <div>
              <strong>Sarah M.</strong>
              <span>Volunteer since 2022</span>
            </div>
          </div>
        </div>
        <div class="quote-card">
          <p class="quote-text">"I foster cats between jobs and it fits perfectly around my schedule. Pawswick make the whole thing so easy and the support is brilliant."</p>
          <div class="quote-author">
            <div class="author-avatar author-avatar-b">D</div>
            <div>
              <strong>Declan O.</strong>
              <span>Foster carer since 2023</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- APPLICATION FORM -->
  <section class="apply-section" id="apply">
    <div class="apply-inner">
      <div class="apply-header">
        <p class="eyebrow">Ready to jump in?</p>
        <h2>Volunteer application</h2>
        <p>Takes about 3 minutes. We'll be in touch within a few days.</p>
      </div>

      <form class="apply-form" name="volunteer" method="POST" data-netlify="true">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" />
          </div>
          <div class="form-group">
            <label for="location">Your area in Dublin</label>
            <input type="text" id="location" name="location" placeholder="e.g. Rathmines, Clontarf..." />
          </div>
        </div>

        <div class="form-group">
          <label>Roles you're interested in (tick all that apply)</label>
          <div class="checkbox-grid">
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="socialisation" />
              <span>Socialisation & care</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="foster" />
              <span>Fostering</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="events" />
              <span>Events & fundraising</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="social-media" />
              <span>Social media & photography</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="admin" />
              <span>Admin & coordination</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="roles" value="transport" />
              <span>Transport & vet runs</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label for="availability">Availability</label>
          <select id="availability" name="availability" required>
            <option value="">Choose one...</option>
            <option value="weekday-mornings">Weekday mornings</option>
            <option value="weekday-afternoons">Weekday afternoons</option>
            <option value="weekends">Weekends</option>
            <option value="flexible">Flexible / varies week to week</option>
          </select>
        </div>

        <div class="form-group">
          <label for="about">Tell us a bit about yourself</label>
          <textarea id="about" name="about" rows="5" placeholder="Any experience with cats, why you want to get involved, anything else we should know..."></textarea>
        </div>

        <button type="submit" class="btn-primary btn-large">Submit application</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo">Pawswick<span>Rescue</span></span>
        <p>A small rescue doing big things for cats in need.</p>
      </div>
      <div class="footer-links">
        <a href="/cats">Cats for adoption</a>
        <a href="/about">About us</a>
        <a href="/volunteer">Volunteer</a>
        <a href="/contact">Contact</a>
        <a href="/donate">Donate</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Pawswick Rescue. Registered charity.</p>
    </div>
  </footer>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:    #FFF8F0;
    --cream2:   #FFF0E0;
    --orange:   #F26430;
    --orange2:  #E04A18;
    --charcoal: #1C1C1C;
    --mid:      #5A5A5A;
    --muted:    #9A8E85;
    --green:    #2D7D4F;
    --green-bg: #E6F4ED;
    --sand:     #F5EDE3;
    --radius:   16px;
    --radius-sm: 8px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 5%;
    background: rgba(255, 248, 240, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(242, 100, 48, 0.1);
  }

  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--charcoal);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .logo span { color: var(--orange); }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  nav ul a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav ul a:hover { color: var(--charcoal); }
  nav ul a.nav-active {
    color: var(--charcoal);
    position: relative;
  }
  nav ul a.nav-active::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0; right: 0;
    height: 2px;
    background: var(--orange);
    border-radius: 2px;
  }

  .nav-cta {
    background: var(--orange) !important;
    color: #fff !important;
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    transition: background 0.2s !important;
  }
  .nav-cta:hover { background: var(--orange2) !important; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--charcoal);
    border-radius: 2px;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.6rem;
  }

  /* PAGE HEADER */
  .page-header {
    background: var(--charcoal);
    padding: 5rem 5%;
  }

  .page-header-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .header-text h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 1.2rem;
  }
  .header-text h1 em {
    font-style: italic;
    color: var(--orange);
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .header-stat-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .header-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 1.2rem 1.8rem;
    width: 100%;
  }

  .header-stat-offset { margin-left: 2rem; }

  .stat-num {
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* ROLES SECTION */
  .roles-section {
    padding: 6rem 5%;
  }

  .roles-inner {
    max-width: 1300px;
    margin: 0 auto;
  }

  .section-label {
    margin-bottom: 3rem;
    max-width: 540px;
  }

  .section-label h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.8rem;
  }

  .section-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--mid);
  }

  .roles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .role-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }
  .role-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
  }

  .role-card-large {
    grid-column: span 2;
    background: #fff;
    border-color: rgba(0, 0, 0, 0.07);
    color: var(--charcoal);
  }

  .role-card-large h3 { color: var(--charcoal); }
  .role-card-large p  { color: var(--mid); }

  .role-icon-wrap {
    width: 52px;
    height: 52px;
    background: rgba(242, 100, 48, 0.12);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    margin-bottom: 0.4rem;
  }

  .role-icon-sm {
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }

  .role-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--charcoal);
  }

  .role-card p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--mid);
    flex-grow: 1;
  }

  .role-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .role-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 100px;
    background: rgba(242, 100, 48, 0.1);
    color: var(--orange);
  }

  .role-card-large .role-tag {
    background: rgba(242, 100, 48, 0.1);
    color: var(--orange);
  }

  /* EXPECT SECTION */
  .expect-section {
    background: var(--cream2);
    padding: 6rem 5%;
  }

  .expect-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .expect-text h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .expect-text > p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--mid);
    margin-bottom: 2.5rem;
  }

  .expect-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .expect-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 28, 28, 0.1);
    transition: padding-left 0.25s ease;
  }
  .expect-step:first-child { border-top: 1px solid rgba(28, 28, 28, 0.1); }
  .expect-step:hover { padding-left: 0.5rem; }

  .step-num {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--orange);
    opacity: 0.7;
    line-height: 1;
    flex-shrink: 0;
    min-width: 48px;
  }

  .expect-step strong {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
    color: var(--charcoal);
  }

  .expect-step p {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0;
  }

  /* QUOTE CARDS */
  .expect-aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 3.5rem;
  }

  .quote-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: var(--radius);
    padding: 1.8rem;
    transition: transform 0.2s ease;
  }
  .quote-card:hover { transform: translateY(-3px); }

  .quote-text {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--charcoal);
    margin-bottom: 1.2rem;
  }

  .quote-author {
    display: flex;
