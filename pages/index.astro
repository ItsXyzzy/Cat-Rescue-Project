---
import { getCollection } from 'astro:content';
const allCats = await getCollection('cats', ({ data }) => data.status === 'Available');
const featuredCats = allCats.slice(0, 3);

const stats = [
  { number: '340+', label: 'cats rehomed' },
  { number: '12', label: 'years running' },
  { number: '98%', label: 'adoption rate' },
];

const steps = [
  { num: '01', title: 'Browse our cats', body: 'Meet every cat in our care, see their personality, age, and whether they suit your home.' },
  { num: '02', title: 'Come say hello', body: "Book a visit to our shelter in Pawswick. Bring the family, we love meeting everyone." },
  { num: '03', title: 'Take them home', body: 'Fill out our simple adoption form and walk out the door with your new best mate.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFF8F0" />
  <title>Pawswick Rescue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="logo">Pawswick<span>Rescue</span></a>
    <ul>
      <li><a href="/cats">Meet the cats</a></li>
      <li><a href="/about">About us</a></li>
      <li><a href="/volunteer">Volunteer</a></li>
      <li><a href="/adopt" class="nav-cta">Adopt now</a></li>
    </ul>
    <button class="menu-toggle" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Open every day, 10am &ndash; 5pm</p>
      <h1>Every cat<br /><em>deserves</em> a<br />soft landing.</h1>
      <p class="hero-sub">We're a small, independent rescue in the heart of Pawswick. Run by volunteers, fuelled by tea, and completely mad about cats.</p>
      <div class="hero-actions">
        <a href="/cats" class="btn-primary">Meet our cats</a>
        <a href="/about" class="btn-ghost">Our story</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="hero-img-wrap">
        <img src="/images/hero-cat.jpg" alt="A happy cat looking for a home" />
      </div>
      <div class="hero-tag">
        <span class="tag-dot"></span>
        <span>24 cats looking for homes</span>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <section class="stats-strip">
    {stats.map(s => (
      <div class="stat">
        <span class="stat-num">{s.number}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- CATS GRID -->
  <section class="cats-section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Ready for a home</p>
        <h2>Looking for their person</h2>
      </div>
      <a href="/cats" class="see-all">See all cats &rarr;</a>
    </div>

    <div class="cat-grid">
      {featuredCats.map(cat => (
        <article class="cat-card">
          <div class="card-img">
            <img src={cat.data.image} alt={cat.data.name} />
            <span class="age-pill">{cat.data.age}</span>
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3>{cat.data.name}</h3>
              <span class={`trait-badge ${cat.data.goodWithKids ? 'trait-green' : 'trait-amber'}`}>
                {cat.data.goodWithKids ? 'Great with kids' : 'Quiet home'}
              </span>
            </div>
            {cat.data.description && <p class="card-desc">{cat.data.description}</p>}
            <a href={`/cats/${cat.id}`} class="card-cta">Meet {cat.data.name}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how-section">
    <div class="how-inner">
      <div class="how-header">
        <p class="eyebrow eyebrow-light">No stress, no fuss</p>
        <h2>How adoption works</h2>
      </div>
      <div class="steps">
        {steps.map(step => (
          <div class="step">
            <span class="step-num">{step.num}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/adopt" class="btn-primary btn-large">Start your adoption</a>
    </div>
  </section>

  <!-- VOLUNTEER BAND -->
  <section class="volunteer-band">
    <div class="vol-content">
      <div class="vol-text">
        <p class="eyebrow">Get involved</p>
        <h2>We run on good people</h2>
        <p>Whether you can spare a few hours a week or want to foster a cat short-term, we'd love your help. Every pair of hands makes a real difference to the cats in our care.</p>
        <a href="/volunteer" class="btn-ghost">Become a volunteer</a>
      </div>
      <div class="vol-cards">
        <div class="vol-card">
          <span class="vol-icon">&#x1F43E;</span>
          <strong>Foster a cat</strong>
          <p>Give a cat a warm home while they wait for their forever family.</p>
        </div>
        <div class="vol-card vol-card-offset">
          <span class="vol-icon">&#x2665;</span>
          <strong>Socialise & care</strong>
          <p>Spend time with our cats, help with feeding and enrichment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo">Pawswick<span>Rescue</span></span>
        <p>A small rescue doing big things for cats in need.</p>
      </div>
      <div class="footer-links">
        <a href="/cats">Cats for adoption</a>
        <a href="/about">About us</a>
        <a href="/volunteer">Volunteer</a>
        <a href="/contact">Contact</a>
        <a href="/donate">Donate</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Pawswick Rescue. Registered charity.</p>
    </div>
  </footer>

  <!-- MOBILE NAVIGATION SCRIPT -->
  <script>
    const menuToggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('nav');

    menuToggle?.addEventListener('click', () => {
      nav?.classList.toggle('nav-open');
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream:   #FFF8F0;
    --cream2:  #FFF0E0;
    --orange:  #F26430;
    --orange2: #E04A18;
    --charcoal:#1C1C1C;
    --mid:     #5A5A5A;
    --muted:   #9A8E85;
    --green:   #2D7D4F;
    --green-bg:#E6F4ED;
    --amber:   #B45309;
    --amber-bg:#FEF3C7;
    --teal:    #0F766E;
    --teal-bg: #CCFBF1;
    --sand:    #F5EDE3;
    --radius:  16px;
    --radius-sm: 8px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 5%;
    background: rgba(255, 248, 240, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(242, 100, 48, 0.1);
  }

  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--charcoal);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .logo span { color: var(--orange); }

  nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  nav ul a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav ul a:hover { color: var(--charcoal); }

  .nav-cta {
    background: var(--orange) !important;
    color: #fff !important;
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    transition: background 0.2s !important;
  }
  .nav-cta:hover { background: var(--orange2) !important; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--charcoal);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* EYEBROW */
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.6rem;
  }
  .eyebrow-light { color: rgba(242, 100, 48, 0.75); }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 90vh;
    padding: 6rem 5% 4rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--charcoal);
    margin-bottom: 1.4rem;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--orange);
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--mid);
    max-width: 440px;
    margin-bottom: 2.2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* BUTTONS */
  .btn-primary {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover { background: var(--orange2); transform: translateY(-2px); }
  .btn-large { padding: 1rem 2.4rem; font-size: 1.05rem; }

  .btn-ghost {
    display: inline-block;
    background: transparent;
    color: var(--charcoal);
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid rgba(28, 28, 28, 0.18);
    transition: border-color 0.2s, transform 0.15s;
  }
  .btn-ghost:hover { border-color: var(--charcoal); transform: translateY(-2px); }

  .btn-ghost-dark {
    border-color: rgba(255,255,255,0.35);
    color: #fff;
  }
  .btn-ghost-dark:hover { border-color: #fff; }

  /* HERO VISUAL */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.45;
    pointer-events: none;
  }
  .blob-1 {
    width: 380px;
    height: 380px;
    background: #FBBF8A;
    top: -60px;
    right: -40px;
    animation: float 8s ease-in-out infinite;
  }
  .blob-2 {
    width: 260px;
    height: 260px;
    background: #FDE68A;
    bottom: 20px;
    left: 0;
    animation: float 10s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.04); }
  }

  .hero-img-wrap {
    position: relative;
    z-index: 2;
    width: 78%;
    aspect-ratio: 3/4;
    border-radius: 40% 60% 55% 45% / 45% 50% 50% 55%;
    overflow: hidden;
    animation: morph 10s ease-in-out infinite;
    box-shadow: 0 30px 80px rgba(242, 100, 48, 0.18);
  }

  @keyframes morph {
    0%, 100% { border-radius: 40% 60% 55% 45% / 45% 50% 50% 55%; }
    33%       { border-radius: 55% 45% 40% 60% / 50% 55% 45% 50%; }
    66%       { border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%; }
  }

  .hero-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-tag {
    position: absolute;
    bottom: 2rem;
    left: -1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border-radius: 100px;
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 500;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    animation: tag-in 0.8s 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes tag-in {
    from { opacity: 0; transform: translateY(12px) scale(0.9); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .tag-dot {
    width: 10px;
    height: 10px;
    background: #22C55E;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
    animation: pulse-dot 2s ease infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25); }
    50%       { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1); }
  }

  /* HERO ENTRANCE ANIMATION */
  .hero-text > * {
    opacity: 0;
    transform: translateY(24px);
    animation: fade-up 0.7s ease forwards;
  }
  .hero-text .eyebrow      { animation-delay: 0.05s; }
  .hero-text h1            { animation-delay: 0.15s; }
  .hero-text .hero-sub     { animation-delay: 0.28s; }
  .hero-text .hero-actions { animation-delay: 0.4s; }

  @keyframes fade-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* STATS STRIP */
  .stats-strip {
    background: var(--charcoal);
    padding: 2.5rem 5%;
    display: flex;
    justify-content: center;
    gap: 6rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-num {
    font-family: 'Fraunces', serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* CATS SECTION */
  .cats-section {
    max-width: 1300px;
    margin: 0 auto;
    padding: 6rem 5%;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .see-all {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--orange);
    text-decoration: none;
    transition: gap 0.2s;
    white-space: nowrap;
  }
  .see-all:hover { text-decoration: underline; }

  /* CAT CARDS */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cat-card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }
  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }

  .card-img {
    position: relative;
    height: 260px;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cat-card:hover .card-img img { transform: scale(1.04); }

  .age-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--charcoal);
  }

  .card-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.8rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-top h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .trait-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .trait-green { background: var(--green-bg); color: var(--green); }
  .trait-amber { background: var(--amber-bg); color: var(--amber); }

  .card-desc {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    display: block;
    text-align: center;
    margin-top: auto;
    padding: 0.75rem;
    background: var(--sand);
    border-radius: var(--radius-sm);
    color: var(--charcoal);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .card-cta:hover { background: var(--orange); color: #fff; }

  /* HOW IT WORKS */
  .how-section {
    background: var(--charcoal);
    padding: 6rem 5%;
  }

  .how-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .how-header {
    margin-bottom: 3.5rem;
  }

  .how-header h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 3rem;
  }

  .step {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    transition: padding-left 0.3s ease;
  }
  .step:hover { padding-left: 0.5rem; }
  .step:first-child { border-top: 1px solid rgba(255,255,255,0.1); }

  .step-num {
    font-family: 'Fraunces', serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
    flex-shrink: 0;
    opacity: 0.85;
    letter-spacing: -0.03em;
    min-width: 60px;
  }

  .step h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .step p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
  }

  /* VOLUNTEER */
  .volunteer-band {
    background: #FFF0E0;
    padding: 6rem 5%;
  }

  .vol-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .vol-text .eyebrow { color: var(--orange); }

  .vol-text h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1.2rem;
    line-height: 1.1;
  }

  .vol-text p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--mid);
    margin-bottom: 2rem;
  }

  .vol-cards {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .vol-card {
    background: #fff;
    border-radius: var(--radius);
    padding: 1.5rem;
    border: 1px solid rgba(242, 100, 48, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .vol-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(242, 100, 48, 0.1);
  }

  .vol-card-offset { margin-left: 2rem; }

  .vol-icon {
    display: block;
    font-size: 1.8rem;
    margin-bottom: 0.6rem;
  }

  .vol-card strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--charcoal);
    margin-bottom: 0.4rem;
  }

  .vol-card p {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0;
  }

  /* FOOTER */
  footer {
    background: #111;
    padding: 3.5rem 5%;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand .logo {
    color: #fff;
  }

  .footer-brand p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.4);
    margin-top: 0.4rem;
  }

