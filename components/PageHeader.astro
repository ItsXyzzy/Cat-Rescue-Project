---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  dark?: boolean;
}

const { eyebrow, title, subtitle, dark = false } = Astro.props;
---

<header class={`page-header ${dark ? 'dark' : ''}`}>
  <div class="page-header-inner">
    <div class="header-text">
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={title} />
      <p class="page-sub">{subtitle}</p>
    </div>
    <slot name="aside" />
  </div>
</header>

<style>
  .page-header {
    background: #FFF8F0;
    padding: 4rem 5%;
  }

  .page-header.dark {
    background: #1C1C1C;
  }

  .page-header-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .header-text h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1.2rem;
  }

  .page-header.dark .header-text h1 {
    color: #fff;
  }

  .page-header:not(.dark) .header-text h1 {
    color: #1C1C1C;
  }

  :global(.page-header h1 em) {
    font-style: italic;
    color: #F26430;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F26430;
    margin-bottom: 0.6rem;
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 0;
    max-width: 500px;
  }

  .page-header.dark .page-sub {
    color: rgba(255, 255, 255, 0.55);
  }

  .page-header:not(.dark) .page-sub {
    color: #5A5A5A;
  }

  @media (max-width: 900px) {
    .page-header-inner { grid-template-columns: 1fr; }
  }
</style>
